{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucine",
  "version": "0.1.0",
  "identifier": "it.local.lucine",
  "build": {"beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist"},
  "app": {
    "windows": [{"title": "Lucine", "width": 820, "height": 640, "minWidth": 600, "minHeight": 520}],
    "security": {"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"}
  },
  "bundle": {"active": true, "targets": ["deb", "appimage"], "icon": ["icons/icon.png"]}
}
